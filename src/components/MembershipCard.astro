---
interface Props {
    url: string;
    title: string;
    price: string;
    benefit?: string;
    class?: string;
}

export const classicBenefits = [
    "Basic benefits",
    "Personal coach",
    "2 daily entries",
    "Swimming pool access"
]

export const commitedBenefits = [
  "Classic benefits",
  "Unlimited daily entries",
  "Invite three friends",
  "Resting room",
  "Free snacks"
]

export const basicBenefits = [
    "Invite two friends",
    "Full facility access",
    "1 daily entry"
]


const {url, title, price, benefit} = Astro.props;

import Button from "./Button.astro"
---
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const cards = document.querySelectorAll(".our-memberships__main .membership-card");
        const centerCard = document.querySelector(".our-memberships__main .membership-card.primary");

        cards.forEach(card => {
            card.addEventListener("mouseenter", () => {
                // Remove primary from all
                cards.forEach(c => c.classList.remove("primary"));
                // Add to hovered
                card.classList.add("primary");
            });

            card.addEventListener("mouseleave", () => {
                // Remove from hovered
                card.classList.remove("primary");
                // Restore to center card if none are hovered
                if (![...cards].some(c => c.matches(":hover"))) {
                    centerCard.classList.add("primary");
                }
            });
        });
    });
</script>

<div class=`membership-card ${Astro.props.class}`>
    <img src={url} alt="Membership logo" class="card__logo">
    <h4 class="card__title">{title}</h4>
    <h5 class="card__price">{price}$ / month</h5>
    <div class="card__benefits-container">
        <slot></slot>
    </div>
    <Button  href="#" text="Start Today" class="darker"/>
</div>

<style is:global>
    .membership-card {
        width: 415px;
        height: 615px;
        background: var(--card-bg-color);
        display: flex;
        flex-direction: column;
        align-items: center;
        border-radius: 1.25rem;
        padding-inline: 1.625rem;
        padding-block: 1.625rem 3rem;
        opacity: 80%;
        -webkit-transition: .2s ease-in-out;
        -moz-transition: .2s ease-in-out;
        -ms-transition: .2s ease-in-out;
        -o-transition: .2s ease-in-out;
        transition: .2s ease-in-out;
    }

    .membership-card:hover {
        transform: scale(1.1);
    }

    .card__logo {
        height: 6.25rem;
    }

    .card__title {
        text-transform: uppercase;
        margin-top: 1rem;
    }

    .card__benefits-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
        margin-bottom: auto;
    }
    
    .card__benefit {
        font-size: 1.75rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .card__benefit:before {
        content: "";
        display: inline-block;
        position: relative;
        aspect-ratio: 1;
        width: 2rem;
        background: url("icons/check.svg");
        margin-right: .75rem;
    }

    .primary {
        /* height: 39.938rem; */
        scale: 1.1;
        box-shadow: 0px 0px 44px 0px rgba(0,0,0,0.75);
        z-index: 100;
        opacity: 100%;
    }

    @media (max-width: 1372px) {
        .membership-card {
            opacity: 100;
        }

        .primary {
            height: 639px;
            box-shadow: none;
            height: 615px;
            z-index: 0;
            scale: 1;
        }
    }

    @media (max-width: 564px) {
        .card__benefit {
            font-size: 1.5rem;
        }

        .membership-card {
            height: 600px;
        }
    }

    @media (max-width: 430px) {
        .membership-card {
            height: 500px;
            width: 300px;
            padding-inline: 1.156rem;
            padding-block: 1.5rem;
        }
        
        .card__benefit {
            font-size: 1.25rem;
        }

        .card__title {
            font-size: 2.25rem;
        }

        .card__benefits-container {
            gap: .5rem;
        }

        .card__logo {
            height: 5rem;
        }
    }
</style>