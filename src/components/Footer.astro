---
import GymLogo from "./GymLogo.astro";
---

<footer id="footer">
    <div id="logo" class="footer__column">
        <GymLogo />
    </div>
    <div id="navigation" class="footer__column">
        <h6 class="column__title">Navigation</h6>
        <a class="column__element" href="#our-facilities">Our facilities</a>
        <a class="column__element" href="#our-coaches">Our coaches</a>
        <a class="column__element" href="#our-memberships">Our memberships</a>
        <a class="column__element" href="#newsletter">Newsletter</a>
    </div>
    <div id="copyright" class="footer__column">
        <a class="column__element">© Tekyo Copyright. All rights reserved.</a>
    </div>
    <div id="newsletter" class="footer__column">
        <h6 class="column__title">Join our newsletter</h6>
        <div class="newsletter__input">
            <div class="newsletter__email">
                <input type="email" name="Email for the newsletter" id="newsletter-email" placeholder="email@example.com">
                <button class="newsletter__btn"><a href="#">Submit</a></button>
            </div>
        </div>
    </div>
</footer>

<style>
    footer {
        display: flex;
        column-gap: 5.25rem;
        justify-content: center;
        align-items: center;
        max-width: 1440px;
        height: 11.875rem;
        margin-inline: auto;
        padding-block: 2rem;
        padding-inline: 4rem;
        text-wrap: nowrap;
    }

    .footer__column {
        display: flex;
        flex-direction: column;
        row-gap: 6px;
    }

    .column__title {
        margin-bottom: 2px;
    }

    .column__element {
        font-size: 1rem;
        font-weight: 400;
    }

    .newsletter__input {
        height: 48px;
        width: 383px;
        padding-left: 1rem;
        border: 3px solid var(--btn-bg-color);
        border-radius: 20px;
    }

    .newsletter__email {
        display: flex;
        justify-content: space-between;
        height: 100%;
    }

    .newsletter__email > * {
        height: 100%;
    }

    .newsletter__btn {
        padding-inline: 1rem;
        background: var(--btn-bg-color);
        border: none;
        border-top-right-radius: 13px;
        border-bottom-right-radius: 13px;
    }

    @media (max-width: 1395px) {
        footer {
            flex-wrap: wrap;
            row-gap: 1.5rem;
            height: fit-content;
        }
        #copyright {
            order: 4;
            margin-inline: auto;
        }
    }

    @media (max-width: 1020px) {
        #navigation {
            order: 3;
        }

        #copyright {
            margin-inline: 0;
        }
    }
</style>