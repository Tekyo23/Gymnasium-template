---
import GymLogo from "./GymLogo.astro";
---

<footer>
    <div class="footer__column">
        <GymLogo />
    </div>
    <div class="footer__column">
        <h6 class="column__title">Navigation</h6>
        <a class="column__element" href="#our-facilities">Our facilities</a>
        <a class="column__element" href="#our-coaches">Our coaches</a>
        <a class="column__element" href="#our-memberships">Our memberships</a>
        <a class="column__element" href="#newsletter">Newsletter</a>
    </div>
    <div class="footer__column">
        <a class="column__element">© Tekyo Copyright. All rights reserved.</a>
    </div>
    <div id="newsletter" class="footer__column">
        <h6 class="column__title">Join our newsletter</h6>
        <div class="newsletter__input">
            <div class="newsletter__email" style="width: 383px; height: 48px; background: red;">
                <input type="email" name="Email for the newsletter" id="newsletter-email" placeholder="email@example.com">
            </div>
            <button class="newsletter__btn">Submit</button>
        </div>
    </div>
</footer>

<style>
    footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1440px;
        height: 11.875rem;
        margin-inline: auto;
        padding-inline: 4rem;
    }

    .footer__column {
        display: flex;
        flex-direction: column;
        row-gap: 6px;
    }

    .column__title {
        margin-bottom: 2px;
    }

    .column__element {
        font-size: 1rem;
        font-weight: 400;
    }

    .newsletter__input {
        border: 3px solid var(--btn-bg-color);
    }

    .newsletter__email > * {
        height: 100%;
    }

    .newsletter__btn {
        background: var(--btn-bg-color);
    }
</style>